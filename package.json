{
  "name": "crossbuy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:md-stars": "node scripts/check-md-stars.mjs",
    "db:generate": "pnpm --filter @crossbuy/db generate",
    "db:migrate": "pnpm --filter @crossbuy/db migrate",
    "db:studio": "pnpm --filter @crossbuy/db studio",
    "deploy": "node scripts/deploy.mjs",
    "blast": "node scripts/blast-radius.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "^5.0.5"
  }
}
