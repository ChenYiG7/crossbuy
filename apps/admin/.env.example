# 运营后台 admin（admin.yiwutaro.com）
NEXT_PUBLIC_API_BASE="/api"

# 数据库连接（M1 §四-4 起 bundle Prisma；本地指向 dump 库，生产经部署环境注入）
DATABASE_URL="mysql://root:root@127.0.0.1:3306/taotaro"

# 后台会话 JWT 签名密钥（与会员端 web 的密钥分离）。production 必填（fail-fast）；
# 开发期不填则用固定开发密钥（启动 warn）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=""
# 后台会话 TTL（秒）——旧 dcat session 2h 空闲过期，取同量级保守值 8h
AUTH_SESSION_TTL_SEC=28800
