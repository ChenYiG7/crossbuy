# 前台 web（www.yiwutaro.com）
# 服务端 API route 用到数据库时再填 DATABASE_URL / REDIS_URL
NEXT_PUBLIC_API_BASE="/api"

# 会员会话 JWT 签名密钥（M1）。production 必填——缺失即拒绝发会话（fail-fast）；
# 开发期不填则用固定开发密钥（启动时有 warn，仅限本地）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=""
# 普通会话 TTL / 「记住我」TTL（秒）
AUTH_SESSION_TTL_SEC=604800
AUTH_SESSION_REMEMBER_TTL_SEC=2592000

# 头像存储怪癖（旧 EditUserInfoMutation 剥离前缀 + resolveAvatarField 补前缀，
# 1:1 复现；不配 = 不剥离/不补，开发期看库原值。禁把测试 bucket 当默认值）
# OSS_BUCKET + OSS_INTERNAL_ENDPOINT → 推导 ossFullHost（写侧剥离）
# OSS_CDN_URL（读侧给 /user/avatar、/avatar 开头的相对 key 补前缀）
OSS_BUCKET=""
OSS_INTERNAL_ENDPOINT=""
OSS_CDN_URL=""
