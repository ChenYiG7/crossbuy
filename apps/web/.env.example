# 前台 web（www.yiwutaro.com）
# 服务端 API route 用到数据库时再填 DATABASE_URL / REDIS_URL
NEXT_PUBLIC_API_BASE="/api"

# 会员会话 JWT 签名密钥（M1）。production 必填——缺失即拒绝发会话（fail-fast）；
# 开发期不填则用固定开发密钥（启动时有 warn，仅限本地）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_SECRET=""
# 普通会话 TTL / 「记住我」TTL（秒）
AUTH_SESSION_TTL_SEC=604800
AUTH_SESSION_REMEMBER_TTL_SEC=2592000
