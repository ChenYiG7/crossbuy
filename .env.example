# 环境变量模板：复制为 .env 后填真实值，绝不提交真实密钥
# 各 app/package 有自己的 .env.example，根这一份用于本地联调兜底

# 数据库（过渡期与旧系统共用同一 MySQL）
DATABASE_URL="mysql://user:password@localhost:3306/yiwutaro?connection_limit=10"

# Redis（BullMQ 队列 + 缓存）
REDIS_URL="redis://localhost:6379"

# 阿里云
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
OSS_REGION="oss-cn-hangzhou"
MNS_ENDPOINT=""

# 钉钉
DINGTALK_WEBHOOK=""

# 支付
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
