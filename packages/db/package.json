{
  "name": "@crossbuy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/redesign/schema.prisma",
    "generate:legacy": "prisma generate --schema prisma/schema.prisma",
    "generate:redesign": "prisma generate --schema prisma/redesign/schema.prisma",
    "pull:legacy": "prisma db pull --schema prisma/schema.prisma && node scripts/post-pull-fixup.mjs",
    "build": "tsc -p tsconfig.json",
    "prebuild": "pnpm generate",
    "pretypecheck": "pnpm generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "echo \"(no tests yet)\"",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "catalog:",
    "typescript": "catalog:"
  }
}
