  shippingFee Decimal @default(0.00) @map("shipping_fee") @db.Decimal(14, 2)
  /// 促销价 CNY（旧 proprice）
  promoPrice Decimal? @map("promo_price") @db.Decimal(14, 2)
  /// 验货金额 CNY（旧 inspection）
  inspectionFee Decimal @default(0.00) @map("inspection_fee") @db.Decimal(14, 2)
  /// 1688 最小起批量（旧 min_order_quantity；按同商品全部 SKU 合计校验）
  minOrderQuantity Int? @default(0) @map("min_order_quantity") @db.UnsignedSmallInt

  // ---- 翻译列 ----
  goodsNameTrans String? @map("goods_name_trans") @db.VarChar(255)
  /// SKU 翻译（旧 sku_trans，cart 旧列为 varchar）
  skuTrans String? @map("sku_trans") @db.VarChar(255)

  // ---- 条款/检品（与 Order 同构收敛，§4.6）----
  /// { qtyShortBuy, priceAdjust, shippingAdjust }（旧 TermQty/TermPrice/TermShipping）
  terms Json?
  /// 1 空运 / 2 海运 / 3 敏感货（旧 ship）
  shipMethod Int? @default(0) @map("ship_method") @db.TinyInt
  /// [{ code, enabled, textValue }]（旧 var1-var12 + yanhuo 家族 + 平台标签 → JSON 受控词表）
  inspectionOptions Json? @map("inspection_options")
  asin String? @db.VarChar(64)  // 旧 yanhuoasin
  fnsku String? @db.VarChar(64) // 旧 yanhuofnsku

  /// 客人外部管理号（旧 outid）
  outId String? @map("out_id") @db.VarChar(80)
  /// 来源（旧 add_from）
  addFrom Int? @default(0) @map("add_from") @db.TinyInt
  /// 来源备注（旧 add_from_memo）
  addFromMemo String? @map("add_from_memo") @db.VarChar(20)
  /// 匿名袋标识（旧 anonymous——客户端防重/会话关联键）
  clientRef String? @map("client_ref") @db.VarChar(50)
  /// 商品备注（旧 goodsremark）
  remark String? @db.VarChar(512)
  createdAt DateTime? @map("created_at") @db.DateTime(0) // 旧 addtime

  valueAddedServices CartValueAddedService[]

  @@index([memberId, type, createdAt])
  @@index([clientRef])
  @@map("carts")
}

/// 购物车增值服务收费（旧源 v2_cart_value_added_service）
model CartValueAddedService {
  id Int @id @default(autoincrement()) // == 旧表 id
  cartId Int @map("cart_id")
  /// 服务目录 id（v2_value_added_service；禁外键）
  serviceId Int @map("service_id")
  nameSnapshot String @map("name_snapshot") @db.VarChar(255)
  remark String? @db.VarChar(255)
  unitPrice Decimal @default(0.00) @map("unit_price") @db.Decimal(14, 2)
  qty Int @default(1)
  fee Decimal @default(0.00) @db.Decimal(14, 2)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  cart Cart @relation(fields: [cartId], references: [id])

  @@index([cartId])
  @@map("cart_value_added_services")
}

// ============================================================================
// send-order 域（旧源 dg_sendorder / dg_fapiao / v2_send_order_label /
//               v2_send_order_invoice_event / v2_sendorder_value_added_service）
// 设计依据 docs/plans/send-order-schema.md；未决问题收口见 06-send-order-评审与拍板.md
// ============================================================================

/// 配送委托运单（sid 维度）。旧源 dg_sendorder
model SendOrder {
  id Int @id @default(autoincrement()) // == 旧 dg_sendorder.sid（回填对齐）
  /// 同捆主运单（旧 parent_id；NULL = 主运单/独立单）——纯组织关系，禁金额 rollup（Q7 拍板）
  bundledIntoId Int? @map("bundled_into_id")
  /// 运单流水号（旧 sn）# 连接多单号时为首段；全量拆分入 snExtra（Q10 拍板）
  sn String? @db.VarChar(64)
  /// 旧 sn 超长/多单号时的全量拆分：{trackingNumbers: [...]}
  snExtra Json? @map("sn_extra")
  memberId Int @map("member_id")
  /// 运单类型：1 普通代购 / 3 一件代发（旧 otype，实测只有 1/3）
  orderType Int @default(1) @map("order_type") @db.TinyInt
  /// 8 态状态机（contract SendOrderStatus）：1 待处理/2 已邮寄/3 已完成/4 无效/
  /// 5 处理中/6 待审核/7 待付款/8 待邮寄；cas 更新
  status Int @default(1) @map("status") @db.SmallInt
  statusEnteredAt DateTime @default(now()) @map("status_entered_at") @db.DateTime(0)
  /// 作业子状态 0-9（contract ProstateCode：0 无/1 等待同梱/2 等OEM同梱/3 FBA作业中/
  /// 4 等客户指示/5 打包中/6 有商品找不到/7 正在做发票/8 拍照中/9 缝标中）——与 status 并存两流
  prostate Int? @map("prostate") @db.TinyInt
  prostateEnteredAt DateTime? @map("prostate_entered_at") @db.DateTime(0)

  // ---- 金额（totalfee 禁存历史值：五费公式服务端现算，§4.3； chargedTotalFee 仅审计）----
  /// 对客国际运费 CNY（旧 freight）
  internationalFreight Decimal @default(0.00) @map("international_freight") @db.Decimal(14, 2)
  /// 采购国际运费 CNY（旧 ufreight，成本）
  purchaseInternationalFreight Decimal @default(0.00) @map("purchase_international_freight") @db.Decimal(14, 2)
  /// 增值费 CNY（旧 serverfee）
  serviceFee Decimal @default(0.00) @map("service_fee") @db.Decimal(14, 2)
  /// 报关费 CNY（旧 customsfee）
  customsFee Decimal @default(0.00) @map("customs_fee") @db.Decimal(14, 2)
  /// 偏远费 CNY（旧 remotefee）
  remoteFee Decimal @default(0.00) @map("remote_fee") @db.Decimal(14, 2)
  /// 国内运费 CNY（旧 sendprice；0 = 走订单兜底，禁直接读）
  domesticShippingFee Decimal @default(0.00) @map("domestic_shipping_fee") @db.Decimal(14, 2)
  /// 保险费 CNY（旧 Insurancefee——禁并入 totalfee，对账单独口径）
  insuranceFee Decimal @default(0.00) @map("insurance_fee") @db.Decimal(14, 2)
  /// 实扣总费快照（已邮寄/支付成功时回写；审计用，禁作业务读值）
  chargedTotalFee Decimal? @map("charged_total_fee") @db.Decimal(14, 2)
  /// 运单砍价汇总（旧 bargainprice = Σ order.bargainprice 排除无效态）
  bargainAmount Decimal @default(0.00) @map("bargain_amount") @db.Decimal(14, 2)
  /// 砍价返金状态（旧 bargainstate：0 未返 / 1 已返）
  bargainRefunded Boolean @default(false) @map("bargain_refunded")
  bargainRefundedAt DateTime? @map("bargain_refunded_at") @db.DateTime(0)
  /// 优惠券快照（旧 couponid/couponmoney；券实体归营销域）
  couponId Int? @map("coupon_id")
  couponAmount Decimal? @map("coupon_amount") @db.Decimal(14, 2)
  /// 损坏/修理费（旧 xiwgfei，本地全 0、无业务逻辑，Q1 拍板：审计兜底禁入公式）
  damageFee Decimal? @map("damage_fee") @db.Decimal(14, 2)
  /// 疑损坏单价（旧 xwdj varchar，语义待查，与 xiwgfei 配对）
  damageUnitPrice String? @map("damage_unit_price") @db.VarChar(255)
  /// 已收取费（旧 yishouqufee）
  receivedFee Decimal? @map("received_fee") @db.Decimal(14, 2)
  /// 仓储费 CNY（旧 storage）
  storageFee Decimal? @map("storage_fee") @db.Decimal(14, 2)
  /// 计费金额（旧 countmoney）
  chargeableAmount Decimal? @map("chargeable_amount") @db.Decimal(14, 2)
  /// 计费重 g（旧 countweight 十进制千克字符串 ×1000，Q2 拍板；不可解析入 legacyExtra）
  chargeableWeightGrams Int? @map("chargeable_weight_grams")

  // ---- 收件人快照（历史事实，保留；uname/memberid/email 会员副本禁冗余——join member）----
  consignee String @db.VarChar(30)
  enName String? @map("en_name") @db.VarChar(30)
  country String? @db.VarChar(30)
  city String? @db.VarChar(30)
  zip String? @db.VarChar(30)
  tel String? @db.VarChar(30)
  address String? @db.VarChar(255)
  /// 进口商信息 JSON（旧 importer_info；real_time_account 禁掩码，§4.8）
  importerInfo Json? @map("importer_info")
  companyName String? @map("company_name") @db.VarChar(100)
  /// 运营备注（旧 remark text）
  remark String? @db.Text

  // ---- 物流/配送 ----
  /// 配送渠道（旧 deliveryname 自由字符串，14 观察值；did 与值不对应已废弃 Q6 拍板）
  deliveryChannel String? @map("delivery_channel") @db.VarChar(30)
  /// 配送区域名（旧 areaname）
  deliveryArea String? @map("delivery_area") @db.VarChar(30)
  /// 发货仓（旧 shipping_warehouse）
  shippingWarehouse String? @map("shipping_warehouse") @db.VarChar(20)
  /// 通关类型（旧 passtype，本地全 0，词表待生产核实）
  passType Int? @map("pass_type") @db.TinyInt
  /// 可否发货（旧 dfsendflag）
  canShip Boolean @default(false) @map("can_ship")
  /// 代发收货码（旧 dfshcode；已邮寄清空）
  dfReceiveCode String? @map("df_receive_code") @db.VarChar(30)
  /// 代发物流号（旧 dflwh）
  dfTrackingNo String? @map("df_tracking_no") @db.VarChar(30)
  /// 代发收件族（旧 dfsendname/dfsendtel/dfsendaddress/dfsendinfo/dfremarkcn）
  dfConsignee String? @map("df_consignee") @db.VarChar(50)
  dfTel String? @map("df_tel") @db.VarChar(50)
  dfAddress String? @map("df_address") @db.VarChar(255)
  dfInfo String? @map("df_info") @db.VarChar(300)
  dfRemarkCn String? @map("df_remark_cn") @db.VarChar(512)

  // ---- 发票/标签/作业 ----
  /// 发票是否给用户（旧 havefapiao）
  invoiceDelivered Boolean @default(false) @map("invoice_delivered")
  /// 发票给用户时间（旧 fapiaotime unix → datetime）
  invoiceDeliveredAt DateTime? @map("invoice_delivered_at") @db.DateTime(0)
  /// 发票完成方式：1 系统生成 / 2 人工生成（旧 invoice_completed_type）
  invoiceCompletedType Int @default(1) @map("invoice_completed_type") @db.TinyInt
  invoiceCompletedAt DateTime? @map("invoice_completed_at") @db.DateTime(0)
  /// 包裹数（旧 totalpackages）
  totalPackages Int? @default(0) @map("total_packages")
  packageName String? @map("package_name") @db.VarChar(50)
  packageId Int? @map("package_id")
  /// 贴标规则 0-3（旧 madeinchina_flag）
  madeInChinaFlag Int? @default(0) @map("made_in_china_flag") @db.TinyInt
  /// 原包装：0 废弃 / 1 保留（旧 origin_package_choice）
  originPackageKeep Boolean @default(false) @map("origin_package_keep")
  /// 邮件备注文本（旧 mailremark 双形态拆分，§4.9）
  mailRemark String? @map("mail_remark") @db.VarChar(1024)
  /// 邮件附件路径数组（旧 mailremark.files）
  mailAttachments Json? @map("mail_attachments")
  /// 评价 JSON（旧 comment/commenttime/reply/showcomment 四合为一：
  /// {content, reply, show, commentedAt}）
  comment Json?
  /// 位运算标记（旧 mark_flag；本地全 NULL 且无位定义，Q5 拍板不拆包）
  markFlags Int? @map("mark_flags")
  /// 历史兜底（旧 sn 超长部分已入 snExtra；countweight 脏值 / xiwgfei 语义查明前原值）
  legacyExtra Json? @map("legacy_extra")

  createdAt DateTime? @map("created_at") @db.DateTime(0) // 旧 addtime unix
  updatedAt DateTime? @map("updated_at") @db.DateTime(0) // 旧 uptime unix
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  bundledInto SendOrder? @relation("Bundle", fields: [bundledIntoId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bundledSendOrders SendOrder[] @relation("Bundle")
  labels SendOrderLabel[]
  invoiceEvents SendOrderInvoiceEvent[]
  valueAddedServices SendOrderValueAddedService[]
  invoices Invoice[]
  statusHistories SendOrderStatusHistory[]

  @@index([memberId, createdAt])
  @@index([status])
  @@index([sn])
  @@index([bundledIntoId])
  @@index([orderType, status])
  @@map("send_orders")
}

/// 运单状态/作业流变迁历史（新系统新增；kind 区分 state 8 态与 prostate 9 态两流，禁混枚举）
model SendOrderStatusHistory {
  id Int @id @default(autoincrement())
  sendOrderId Int @map("send_order_id")
  /// 流类型：state（客户可见生命周期）/ prostate（仓库作业子状态）
  kind String @db.VarChar(16)
  fromStatus Int? @map("from_status")
  toStatus Int @map("to_status")
  /// 操作者类型：member / admin / system / worker
  operatorType String @map("operator_type") @db.VarChar(16)
  operatorId Int? @map("operator_id")
  reason String? @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  sendOrder SendOrder @relation(fields: [sendOrderId], references: [id])

  @@index([sendOrderId, createdAt])
  @@index([kind])
  @@map("send_order_status_histories")
}

/// 客户上传标签（旧源 v2_send_order_label）。文件走 OSS，库内只存 path——禁 base64
model SendOrderLabel {
  id BigInt @id @default(autoincrement()) // == 旧表 id（bigint unsigned）
  sendOrderId Int @map("send_order_id")
  memberId Int @map("member_id")
  /// 标签类型：fba_box FBA 箱标 / fba_item FNSKU 商品标 / 3pl_box 其他 3PL 箱标 / carrier 运单
  type String @db.VarChar(16)
  filePath String @map("file_path") @db.VarChar(255)
  fileName String @map("file_name") @db.VarChar(191)
  mime String @db.VarChar(32)
  size Int @default(0)
  /// FBA 货件编号（FBA 标签时）
  fbaShipmentId String? @map("fba_shipment_id") @db.VarChar(64)
  /// 目的仓库代码
  destinationCode String? @map("destination_code") @db.VarChar(32)
  /// [{box_no, oid, qty}]
  boxes Json?
  /// 状态：0 已收到 / 1 已贴 / 2 已扫描核对
  status Int @default(0) @db.TinyInt
  /// 扫描核对结果（仓库填）
  scanResult Json? @map("scan_result")
  /// 贴好后的照片（仓库填）
  photoUrls Json? @map("photo_urls")
  appliedAt DateTime? @map("applied_at") @db.DateTime(0)
  verifiedAt DateTime? @map("verified_at") @db.DateTime(0)
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  sendOrder SendOrder @relation(fields: [sendOrderId], references: [id])

  @@index([sendOrderId, type])
  @@index([status])
  @@index([memberId])
  @@map("send_order_labels")
}

/// 发票事件流（旧源 v2_send_order_invoice_event；append-only，禁更新）
model SendOrderInvoiceEvent {
  id BigInt @id @default(autoincrement()) // == 旧表 id（bigint unsigned）
  sendOrderId Int @map("send_order_id")
  memberId Int @map("member_id")
  /// 事件类型：revise_requested 客户要求修改发票 / paid_confirmed 支付＝确认了这一版发票
  type String @db.VarChar(32)
  /// 当时的发票版本（内容指纹；开放接口锁内校验的关键）
  invoiceVersion String @map("invoice_version") @db.VarChar(32)
  /// 修改要求的内容
  comment String? @db.Text
  /// 客户附的图片 URL
  imageUrls Json? @map("image_urls")
  /// 来源：api / web
  source String @default("api") @db.VarChar(16)
  /// 为修改要求建的工单（可溯源到 ticket 域）
  ticketId BigInt? @map("ticket_id")
  createdAt DateTime? @map("created_at") @db.DateTime(0)

  sendOrder SendOrder @relation(fields: [sendOrderId], references: [id])

  @@index([sendOrderId, createdAt])
  @@index([ticketId])
  @@map("send_order_invoice_events")
}

/// 运单增值服务收费（旧源 v2_sendorder_value_added_service）
model SendOrderValueAddedService {
  id Int @id @default(autoincrement()) // == 旧表 id
  sendOrderId Int @map("send_order_id")
  /// 服务目录 id（禁外键）
  serviceId Int @map("service_id")
  nameSnapshot String @map("name_snapshot") @db.VarChar(255)
  fee Decimal @default(0.00) @db.Decimal(14, 2)
  /// 手工加项标记（非客户自助勾选）
  isManual Boolean @default(false) @map("is_manual")
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)

  sendOrder SendOrder @relation(fields: [sendOrderId], references: [id])

  @@index([sendOrderId])
  @@map("send_order_value_added_services")
}

/// 发票（旧源 dg_fapiao，371 万+ 行；Q3 拍板归 send-order 域，sid 维度出货文件快照）
/// ⚠ 整表是「出货文件快照」：收件人/会员/货物信息为历史事实，禁反查实时表
model Invoice {
  id Int @id // == 旧 dg_fapiao.fid（回填对齐）
  sendOrderId Int @map("send_order_id")
  orderId Int @map("order_id")
  memberId Int @map("member_id")
  /// 地址簿 ID（旧 cid；0 → NULL，本地 78,344 行=0）
  addressBookId Int? @map("address_book_id")

  // ---- 会员快照（旧 uname/utel/upost/uaddress；历史事实）----
  memberName String? @map("member_name") @db.VarChar(50)
  memberTel String? @map("member_tel") @db.VarChar(20)
  memberPost String? @map("member_post") @db.VarChar(20)
  memberAddress String? @map("member_address") @db.VarChar(200)

  // ---- 收件人快照（旧 cname/ctel/cpost/caddress）----
  consigneeName String? @map("consignee_name") @db.VarChar(50)
  /// 货品溶剂？（旧 goodsrongji，语义待查）
  goodsRongji String? @map("goods_rongji") @db.VarChar(50)
  consigneeTel String? @map("consignee_tel") @db.VarChar(20)
  consigneePost String? @map("consignee_post") @db.VarChar(20)
  consigneeAddress String? @map("consignee_address") @db.VarChar(200)

  // ---- 物流/包装 ----
  transport String? @db.VarChar(50)
  /// 航空运单号（旧 airbill varchar(2512)；多单号场景首段 ≤64，全量入 legacyExtra）
  airbill String? @db.VarChar(64)
  /// 总重（旧 totalweight——含代码值如 'A'，语义待查，Q2 拍板禁转数值）
  totalWeight String? @map("total_weight") @db.VarChar(32)
  country String? @db.VarChar(50)
  teams String? @db.VarChar(50)
  packages String? @db.VarChar(50)
  /// 关税（旧 tariff varchar，原样字符串）
  tariff String? @db.VarChar(50)
  /// 国际品名（旧 goodsinternational varchar(1150)）
  goodsInternational String? @map("goods_international") @db.VarChar(1150)
  /// 数量合计（旧 amount int）
  amount Int?
  boxNum Int? @map("box_num")
  /// 混装箱号（旧 hyboxnum varchar(500)）
  hyBoxNum String? @map("hy_box_num") @db.VarChar(500)

  // ---- 货物族 ----
  goodsPrice Decimal? @map("goods_price") @db.Decimal(14, 2)
  goodsName String? @map("goods_name") @db.VarChar(200)
  goodsCaizhi String? @map("goods_caizhi") @db.VarChar(50)
  goodsNum Int? @map("goods_num")
  goodsUrl String? @map("goods_url") @db.VarChar(255)
  goodsId String? @map("goods_id") @db.VarChar(30)
  goodsImg String? @map("goods_img") @db.VarChar(300)
  /// 订单重量（旧 orderweight float(10,2)）
  orderWeight Decimal? @map("order_weight") @db.Decimal(10, 2)
  goodsTotal Decimal? @map("goods_total") @db.Decimal(14, 2)
  subtotal Decimal? @db.Decimal(14, 2)
  bargainPrice Decimal? @map("bargain_price") @db.Decimal(14, 2)
  /// 材质备注（旧 gcaizhimemo）
  caizhiMemo String? @map("caizhi_memo") @db.VarChar(50)
  /// 低申报倍数（旧 lowmultiple float(10,2)）
  lowMultiple Decimal? @map("low_multiple") @db.Decimal(10, 2)
  /// 中国品名（旧 expcnname）
  expCnName String? @map("exp_cn_name") @db.VarChar(30)
  enName String? @map("en_name") @db.VarChar(60)
  goodsUseful String? @map("goods_useful") @db.VarChar(10)
  usefulMemo String? @map("useful_memo") @db.VarChar(50)

  // ---- 销售/汇率 ----
  exportName String? @map("export_name") @db.VarChar(200)
  /// 汇率快照（旧 exchangerate float(10,2)；★ Q8 定版汇率统一 Decimal(12,8)，
  /// 因 JPY→CNY 量级仅 0.04x，两位小数只剩 2 位有效数字，见 finance-schema.md §3.3）
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(12, 8)
  salesName String? @map("sales_name") @db.VarChar(200)
  salesTel String? @map("sales_tel") @db.VarChar(20)
  rateType Int? @map("rate_type")
  /// 国内运费（旧 sendprice float(10,2)）
  sendPrice Decimal? @map("send_price") @db.Decimal(14, 2)

  // ---- 包装明细 ----
  packageName String? @map("package_name") @db.VarChar(100)
  packageId Int? @map("package_id")

  /// 旧表无时间列；新系统审计用（回填空置，新写入必须赋值）
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  /// 历史兜底（airbill 超长全量 / totalweight 原值异常时的留档）
  legacyExtra Json? @map("legacy_extra")

  sendOrder SendOrder @relation(fields: [sendOrderId], references: [id])

  @@index([sendOrderId])
  @@index([orderId])
  @@index([memberId])
  @@map("invoices")
}
