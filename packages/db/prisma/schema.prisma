// ============================================================================
// Prisma schema —— 本文件是数据库结构的「正本」。
//
// 纪律（docs/07-开发规范守则）：
//   - 金额一律 Decimal，禁 float/double；且余额正本在 ledger，不在此表
//   - 状态/枚举列用 Int/String + /// 注释写明含义（词表正本在 packages/contract）
//   - 业务唯一键必须建（幂等的根本）
//   - 禁外键与级联（引用完整性归应用层）→ relationMode = "prisma"
//   - 列名一律 snake_case（Prisma 默认用字段名当列名 → 每个多词字段须 @map）
//
// 当前内容 = 【member 域 + order 域 + send-order 域新表正本】
//   - 决策（Q7，2026-10-13）：**新表为唯一正本**，不继承旧表结构。
//   - 过渡期旧表（dg_users 等）由「同库同事务双写」保持可用，见
//     docs/plans/member-迁移与共存.md。
//   - 本文件表名/列名均为新设计的干净命名（无 v2_ / dg_ 前缀）。
//   - 字段级来源与转换规则见 docs/plans/01-v2表字段精读.md 与 member-迁移与共存.md。
//   - order 域设计依据 docs/plans/order-schema.md；Q5（OrderGroup 显式化）已拍板，
//     见 docs/plans/05-order-group-评审与拍板.md。
//   - send-order 域设计依据 docs/plans/send-order-schema.md；Q3（发票归本域）等
//     七条未决问题已收口，见 docs/plans/06-send-order-评审与拍板.md。
//     ⚠ 跨域引用（orders.send_order_id → send_orders.id）只存标量列 + 索引，
//       禁建 Prisma relation（域间禁横向依赖，docs/07 铁律 5）。
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma" // 禁 DB 级外键：关系由应用层维护
}

// ============================================================================
// member 域
// ============================================================================

/// 会员（正本；旧源 dg_users）
model Member {
  id                  Int     @id @default(autoincrement())
  /// 登录名（唯一）。⚠ 旧表 uname 允许重名 → 上线前须查重（Q4）
  username            String  @unique @db.VarChar(50)
  /// 重名消歧：改名前的原名（仅 `usernameAutoRenamed=1` 时有值），便于客服/审计
  usernameOriginal    String? @map("username_original") @db.VarChar(50)
  /// 是否因重名被自动改名：1=是（登录时提示）。Q4 消歧，见 docs/plans/02-用户名重名处置.md
  usernameAutoRenamed Int?    @default(0) @map("username_auto_renamed") @db.TinyInt
  /// 账号合并目标（被并入的主账号 id）。当前仅 Haru0128: 15274 → 15272
  mergedIntoId        Int?    @map("merged_into_id")
  /// 密码哈希（目标 argon2id）
  passwordHash        String  @map("password_hash") @db.VarChar(255)
  /// 哈希算法标识：argon2id / bcrypt / md5（过渡期回填的旧数据）
  passwordAlgo        String  @default("argon2id") @map("password_algo") @db.VarChar(16)
  email               String? @db.VarChar(50)
  /// 姓名（汉字）
  name                String? @db.VarChar(50)
  /// 客人英文名
  enName              String? @map("en_name") @db.VarChar(60)
  /// 外部会员号
  memberId            String? @map("member_id") @db.VarChar(30)
  /// 头像 URL
  face                String? @db.VarChar(128)

  // ---- 基本资料 ----
  sex     Int?    @default(0) @db.SmallInt
  tel     String? @db.VarChar(50)
  zip     String? @db.VarChar(20)
  country String? @db.VarChar(50)
  city    String? @db.VarChar(50)
  address String? @db.VarChar(255)
  qq      String? @default("") @db.VarChar(20)
  msn     String? @default("") @db.VarChar(50)
  line    String? @db.VarChar(30)
  wechat  String? @db.VarChar(30)
  card    String? @db.VarChar(20)

  // ---- 身份 / 状态（枚举值待确认，member-schema.md Q1）----
  /// 用户类型（旧 utype，语义待确认）
  utype         Int?    @default(0) @db.SmallInt
  /// 账户用途：1 代理購入 / 2 転送 / 3 無在庫 / 4 OEM
  useType       Int?    @map("use_type") @db.TinyInt
  /// 状态（旧 state，默认 1）
  state         Int?    @default(1) @db.SmallInt
  /// 有效期（旧 validity，语义待确认）
  validity      Int?
  /// 注册类型：0 个人 / 1 公司
  regType       Int?    @map("reg_type") @db.TinyInt
  /// 业务身份：MZK 无在库 / PROXY_PURCHASE 代采
  bizCode       String  @default("PROXY_PURCHASE") @map("biz_code") @db.VarChar(56)
  /// 负责公司：hho / gouba
  belongCompany String? @map("belong_company") @db.VarChar(32)
  /// 用户标签
  tag           String? @db.VarChar(255)

  // ---- 资金（正本在 finance.ledger_entries；下列为冗余/快照）----
  /// 账户余额（缓存列，唯一写入口 + 原子守卫维护）
  balance              Decimal?  @default(0.00) @db.Decimal(14, 2)
  /// 余额币种 —— ★ 2026-10-15 Q1 定版：旧库对客全链路（货价/余额/流水/运单费）面值是 CNY，
  /// 故账本与投影列都按 CNY 记；JPY 只存在于充值原币（recharge_orders.source_amount）与前台展示层。
  /// 货币隔离，禁跨币种直接加减（finance-schema.md §3.3 / §八 Q1）
  balanceCurrency      String?   @default("CNY") @map("balance_currency") @db.VarChar(8)
  /// 积分
  scores               Int?      @default(0)
  /// 对客浮动汇率：基准汇率上加该值
  floatRate            Decimal?  @default(0.05) @map("float_rate") @db.Decimal(10, 2)
  /// 余额最后变动时间
  lastBalanceChangedAt DateTime? @map("last_balance_changed_at") @db.DateTime(0)
  /// 是否可交易：0 不可 / 1 可（下单前必查）
  orderEnable          Int?      @default(1) @map("order_enable") @db.TinyInt
  /// 交易终止时间
  stopTime             DateTime? @map("stop_time") @db.DateTime(0)

  // ---- 代发（dfflag 家族）----
  /// 代发优先：0 非代发 / 1 代发优先 / 2 普通代购优先
  dfFlag        Int?     @default(0) @map("df_flag") @db.TinyInt
  /// 一件代发费用
  dfFee         Decimal? @default(10.00) @map("df_fee") @db.Decimal(14, 2)
  dfSendName    String?  @map("df_send_name") @db.VarChar(50)
  dfSendAddress String?  @map("df_send_address") @db.VarChar(200)
  dfSendTel     String?  @map("df_send_tel") @db.VarChar(50)
  /// CSV 上传功能开关
  csvUpFlag     Int?     @default(0) @map("csv_up_flag") @db.TinyInt

  // ---- 经营资料 / 偏好 ----
  realtimeAccount     String?  @map("realtime_account") @db.VarChar(255)
  shopName            String?  @map("shop_name") @db.VarChar(100)
  shopUrl             String?  @map("shop_url") @db.VarChar(200)
  preBuyFeq           String?  @map("pre_buy_feq") @db.VarChar(60)
  preBuyAmt           String?  @map("pre_buy_amt") @db.VarChar(60)
  /// 月额会员每月扣费（日元）
  monPayAmt           Decimal? @default(30000) @map("mon_pay_amt") @db.Decimal(14, 2)
  /// 是否保留原包装：0 废弃 / 1 保留
  originPackageChoice Int?     @default(0) @map("origin_package_choice") @db.TinyInt
  /// 拍货分派选中值
  xz                  String?  @default("0") @db.VarChar(50)
  /// 业务员
  fb                  String?  @db.VarChar(11)
  /// 注册附加信息
  regExtra            String?  @map("reg_extra") @db.VarChar(1024)
  remark              String?  @db.Text

  // ---- 通知 / 邮件 ----
  /// 到着邮件频率：1 实时 / 2 每小时 / 3 每 6 小时 / 4 每天
  mailFrequency        Int?  @default(4) @map("mail_frequency") @db.TinyInt
  /// 邮件订阅位标记（位定义待确认，Q5）
  emailSubscribeStatus Int?  @map("email_subscribe_status")
  /// 抄送邮箱
  ccEmails             Json? @map("cc_emails")
  /// 登录限制邮件提醒
  loginLimitWarning    Int?  @default(0) @map("login_limit_warning") @db.TinyInt

  // ---- 仓储 ----
  storesFreeDays Int? @default(90) @map("stores_free_days")
  storesWarnDays Int? @default(82) @map("stores_warn_days")

  // ---- 登录 / 时间 ----
  regIp       String?   @map("reg_ip") @db.Char(16)
  createdAt   DateTime  @map("created_at") @db.DateTime(0)
  loginIp     String?   @map("login_ip") @db.Char(16)
  lastLoginAt DateTime? @map("last_login_at") @db.DateTime(0)
  lastOrderAt DateTime? @map("last_order_at") @db.DateTime(0)
  activeKey   String?   @map("active_key") @db.Char(5)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(0)

  // ---- 关系（应用层维护，DB 无 FK）----
  company            MemberCompany?
  addresses          MemberAddress[]
  webhook            MemberWebhook?
  oauthLogins        OauthLogin[]
  favorites          Favorite[]
  favoriteCategories FavoriteCategory[]
  browseHistories    BrowseHistory[]
  benefits           MemberBenefit[]
  operationLogs      MemberOperationLog[]

  @@index([email])
  @@index([memberId])
  @@index([bizCode])
  @@index([state])
  @@map("member")
}

/// 会员法人信息（1:1，仅 regType=1；旧页 dg_users 的 com* 组拆出）
model MemberCompany {
  memberId   Int     @id @map("member_id")
  /// 会社名（漢字）
  name       String? @db.VarChar(50)
  /// 会社名（アルファベット）
  engName    String? @map("eng_name") @db.VarChar(50)
  /// 担当者名（漢字）
  manager    String? @db.VarChar(50)
  /// 担当者名（アルファベット）
  managerEng String? @map("manager_eng") @db.VarChar(50)
  /// 法人番号 / JASTPRO コード
  post       String? @db.VarChar(50)
  /// 会社電話番号
  tel        String? @db.VarChar(30)
  address    String? @db.VarChar(255)
  engAddress String? @map("eng_address") @db.VarChar(255)
  zip        String? @db.VarChar(255)
  /// 商号名
  busNum     String? @map("bus_num") @db.VarChar(100)

  member Member @relation(fields: [memberId], references: [id])

  @@map("member_company")
}

/// 会员地址（旧源 dg_address）
model MemberAddress {
  id              Int     @id @default(autoincrement())
  memberId        Int     @map("member_id")
  /// 收件人姓名
  consignee       String  @db.VarChar(30)
  enName          String? @map("en_name") @db.VarChar(100)
  country         String? @db.VarChar(30)
  city            String? @db.VarChar(30)
  zip             String? @db.VarChar(30)
  tel             String? @db.VarChar(30)
  address         String? @db.VarChar(255)
  /// 类型：1 收货人地址 / 2 进口商地址
  type            Int     @default(1) @db.TinyInt
  email           String? @db.VarChar(30)
  /// 银行账号信息
  bankInfo        String? @map("bank_info") @db.VarChar(255)
  /// 企业信息 JSON（公司名称 / 税号 / 关税号）
  corporateInfo   String? @map("corporate_info") @db.VarChar(255)
  /// 是否默认地址：0 否 / 1 是
  isDefault       Int?    @default(0) @map("is_default") @db.SmallInt
  /// 进口商输入番号
  customsCode     String? @map("customs_code") @db.VarChar(255)
  realTimeAccount String? @map("real_time_account") @db.VarChar(255)
  /// 法人番号
  corporateNumber String? @map("corporate_number") @db.VarChar(100)
  companyName     String? @map("company_name") @db.VarChar(50)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, type])
  @@map("member_address")
}

/// 会员 Webhook 配置（旧源 v2_member_webhook）
model MemberWebhook {
  id                  BigInt    @id @default(autoincrement())
  /// 一个会员一个接收 URL
  memberId            Int       @unique @map("member_id")
  url                 String    @db.VarChar(500)
  /// 签名密钥（加密保存，禁明文落库）
  secret              String    @db.Text
  /// 是否发送：1 发送 / 0 停用
  enabled             Boolean   @default(true) @db.TinyInt
  /// 余额低于此值时发 balance.low，空=不发
  balanceLowThreshold Decimal?  @map("balance_low_threshold") @db.Decimal(14, 2)
  createdAt           DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime? @map("updated_at") @db.Timestamp(0)

  member Member @relation(fields: [memberId], references: [id])

  @@map("member_webhook")
}

/// 会员 Webhook 投递队列（旧源 v2_member_webhook_delivery）★ 幂等出站
model MemberWebhookDelivery {
  id             BigInt    @id @default(autoincrement())
  memberId       Int       @map("member_id")
  /// 事件名
  event          String    @db.VarChar(64)
  /// 去重键：同一事件只发一次（幂等根）
  eventKey       String    @unique @map("event_key") @db.VarChar(191)
  payload        Json
  /// 状态：0 待发送 / 1 成功 / 2 放弃
  status         Int       @default(0) @db.UnsignedTinyInt
  attempts       Int       @default(0) @db.UnsignedTinyInt
  lastStatusCode Int?      @map("last_status_code") @db.UnsignedSmallInt
  lastError      String?   @map("last_error") @db.VarChar(255)
  /// 下次发送时间（待发送时；成功/放弃后为空）
  nextAttemptAt  DateTime? @map("next_attempt_at") @db.Timestamp(0)
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamp(0)
  createdAt      DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([memberId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("member_webhook_delivery")
}

/// 个人访问令牌（旧源 v2_personal_access_tokens）
model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement())
  /// 主体（旧为 Laravel morph）—— 契约层收口为 Member
  tokenableType String    @map("tokenable_type") @db.VarChar(255)
  tokenableId   BigInt    @map("tokenable_id")
  name          String    @db.VarChar(255)
  /// 令牌（哈希存储）
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamp(0)
  expiresAt     DateTime? @map("expires_at") @db.Timestamp(0)
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  @@index([tokenableType, tokenableId])
  @@map("personal_access_token")
}

/// OAuth 登录绑定（旧源 v2_oauth_login）
model OauthLogin {
  id        Int       @id @default(autoincrement())
  memberId  Int       @map("member_id")
  appid     String    @db.VarChar(50)
  openid    String    @db.VarChar(50)
  detail    String?   @db.Text
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  member Member @relation(fields: [memberId], references: [id])

  @@unique([openid, appid])
  @@index([memberId])
  @@map("oauth_login")
}

/// 淘宝全球购授权（旧源 v2_oauth_taobao_global）
model OauthTaobaoGlobal {
  id        Int       @id @default(autoincrement())
  account   String?   @db.VarChar(50)
  token     Json?
  memberId  Int?      @map("member_id")
  sellerId  String?   @map("seller_id") @db.VarChar(50)
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  @@map("oauth_taobao_global")
}

/// 开放 API 幂等键（旧源 v2_open_api_idempotency）★ 幂等标准实现
model OpenApiIdempotency {
  id          BigInt    @id @default(autoincrement())
  memberId    Int       @map("member_id")
  /// 作用域：orders 下单 / send_orders 配送委托
  scope       String    @db.VarChar(32)
  /// 客户防重键（client_order_id / Idempotency-Key）
  clientKey   String    @map("client_key") @db.VarChar(64)
  /// 首次请求内容 sha256（同键换内容 → 422）
  requestHash String?   @map("request_hash") @db.Char(64)
  /// 状态：0 处理中 / 1 完成
  status      Int       @default(0) @db.UnsignedTinyInt
  /// 首次结果（第 2 次起原样返回）
  response    Json?
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  @@unique([memberId, scope, clientKey])
  @@index([createdAt])
  @@map("open_api_idempotency")
}

/// 收藏（旧源 v2_favorite）
model Favorite {
  id               Int       @id @default(autoincrement())
  memberId         Int       @map("member_id")
  categoryId       Int       @default(0) @map("category_id")
  /// 多态目标：店铺 / 商品（契约层收口为枚举）
  favoriteableType String    @map("favoriteable_type") @db.VarChar(255)
  favoriteableId   Int       @map("favoriteable_id")
  /// 扩展信息 JSON（sku / asin / fnsku / outid）
  extra            String?   @db.Text
  memo             String    @default("") @db.VarChar(255)
  createdAt        DateTime  @map("created_at") @db.DateTime(0)
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, categoryId])
  @@index([favoriteableId, favoriteableType])
  @@map("favorite")
}

/// 收藏分类（旧源 v2_favorite_category）
model FavoriteCategory {
  id        Int       @id @default(autoincrement())
  memberId  Int       @map("member_id")
  name      String    @default("") @db.VarChar(255)
  /// 类型：1 商品 / 2 店铺
  type      Int?      @default(0) @db.TinyInt
  sort      Int?      @default(0) @db.UnsignedTinyInt
  createdAt DateTime  @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("favorite_category")
}

/// 浏览记录（旧源 v2_user_browse_history）★ 高频写
model BrowseHistory {
  id        Int       @id @default(autoincrement())
  memberId  Int       @map("member_id")
  /// 商品表主键
  goodsId   Int       @map("goods_id")
  createdAt DateTime  @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId, createdAt])
  @@map("browse_history")
}

/// 权益配置（旧源 user_benefit_configs）
model BenefitConfig {
  id              Int       @id @default(autoincrement())
  benefitCode     String    @unique @map("benefit_code") @db.VarChar(50)
  benefitName     String    @map("benefit_name") @db.VarChar(100)
  /// 权益类型：1 会员续期 / 2 手续费抵扣
  benefitType     Int       @map("benefit_type") @db.TinyInt
  benefitConfig   Json?     @map("benefit_config")
  validDays       Int?      @default(0) @map("valid_days")
  activityStartAt DateTime? @map("activity_start_at") @db.Timestamp(0)
  activityEndAt   DateTime? @map("activity_end_at") @db.Timestamp(0)
  userConditions  Json?     @map("user_conditions")
  /// 状态：0 禁用 / 1 启用
  status          Int?      @default(1) @db.TinyInt
  sortOrder       Int?      @default(0) @map("sort_order")
  features        Json?
  remark          String?   @db.Text
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  benefits MemberBenefit[]

  @@index([activityStartAt, activityEndAt])
  @@index([benefitType])
  @@map("benefit_config")
}

/// 会员权益（旧源 user_benefits）
model MemberBenefit {
  id              BigInt    @id @default(autoincrement())
  memberId        Int       @map("member_id")
  benefitConfigId Int       @map("benefit_config_id")
  benefitCode     String    @map("benefit_code") @db.VarChar(50)
  benefitName     String    @map("benefit_name") @db.VarChar(100)
  /// 权益类型：1 会员续期 / 2 手续费抵扣
  benefitType     Int       @map("benefit_type") @db.TinyInt
  benefitValue    Json?     @map("benefit_value")
  /// 状态：1 未使用 / 2 已使用 / 3 已过期
  status          Int?      @default(1) @db.TinyInt
  /// 来源：purchase 购买赠送 / activity 活动赠送 / manual 手动发放
  source          String?   @db.VarChar(50)
  sourceId        String?   @map("source_id") @db.VarChar(100)
  receivedAt      DateTime? @map("received_at") @db.Timestamp(0)
  startAt         DateTime? @map("start_at") @db.Timestamp(0)
  usedAt          DateTime? @map("used_at") @db.Timestamp(0)
  expiredAt       DateTime? @map("expired_at") @db.Timestamp(0)
  features        Json?
  remark          String?   @db.Text
  createdAt       DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime? @map("updated_at") @db.Timestamp(0)

  member Member        @relation(fields: [memberId], references: [id])
  config BenefitConfig @relation(fields: [benefitConfigId], references: [id])

  @@unique([memberId, benefitConfigId])
  @@index([memberId, status])
  @@index([benefitConfigId])
  @@index([source, sourceId])
  @@map("member_benefit")
}

/// 会员资料修改审计（旧源 user_operation_log）
model MemberOperationLog {
  id        BigInt    @id @default(autoincrement())
  memberId  Int       @map("member_id")
  /// 操作员 uid（0 = 系统）
  operator  Int
  remark    String?   @default("") @db.VarChar(200)
  createdAt DateTime? @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)

  member Member @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@map("member_operation_log")
}

/// 行政区划字典（旧源 v2_area；v2_address 为老代重复表，弃用）
/// 建议后续移入 common/geo 域，此处随 member 试水先行落位
model Area {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(255)
  /// 层级：1 国家 / 2 省·州 / 3 市·县 / 4 区·镇 / 5 街道·村
  level        Int     @db.UnsignedTinyInt
  parentId     Int     @map("parent_id")
  /// ISO 3166-1 二位国家代码
  countryCode  String  @map("country_code") @db.Char(2)
  /// 官方行政区划代码
  officialCode String? @map("official_code") @db.VarChar(50)

  @@index([countryCode])
  @@index([parentId])
  @@map("area")
}

// ============================================================================
// finance 域（2026-10-15，TODO #11）
//
// 设计依据：docs/plans/finance-schema.md（dg_record / dg_rechargerecord /
//   finance_order_cash_flow / dg_huilv 列级精读 + action 全量 21 值词表逆向 +
//   实测账本链断 7.3% 行 / 55% 会员 + 14 条建模决策）
//   - ★ Q1 定版（2026-10-15）：账本面值 = **CNY**。旧库对客全链路实测是人民币，
//     按 JPY 回填 = 静默放大 ~22 倍
//   - ★ Q8 定版：金额 `Decimal(14,2)`、汇率 `Decimal(12,8)`
//   - 账户制单式流水（6 类账户），**不做复式科目树**（§4.1）
//   - `ledger_entries` 是 append-only：故意不给 `updated_at` / `deleted_at`——
//     更正只能加反向分录，不可变性优先于建表规约统一（§4.5，docs/07 §6.2 的本域特例）
//   - 唯一写入口 `ledger.post()`：链式不变式 balance_after = balance_before + signed_amount
//     + 幂等键 `@@unique(account_id, idempotency_key)`（旧库同名列 100% NULL，§3.9）
//   - ⚠ 原**占位模型** LedgerEntry（DR/CR、无账户、无余额快照、无业务唯一键）已整体替换。
//     旧表名 `ledger_entry` → 新表名 `ledger_entries`：生产从未建过占位表，但演练库若残留，
//     请手工 DROP（`0001-member-domain-up.sql` 重生成后不再包含它）
// ============================================================================

/// 账户行（余额正本挂载点）；唯一写入口 ledger.post() 的守卫对象
model Account {
  id     BigInt @id @default(autoincrement())
  /// MEMBER 会员余额户 / COMPANY 平台收入 / PURCHASE 采购成本 / FREIGHT 运费 /
  /// CHANNEL_IN_TRANSIT 渠道在途 / ADJUSTMENT 人工调整损益（词表正本在 contract）
  kind   String @db.VarChar(24)
  /// kind=MEMBER 时 == member.id（== 旧 dg_users.uid）；其余账户 NULL
  /// ⚠ MySQL 唯一索引里 NULL 互不相等 → 非会员账户不受 @@unique(kind,memberId) 约束，
  ///   「一个 kind 只允许一个」要靠应用层或 sentinel 收口（登记 TODO #11c）
  memberId Int? @map("member_id")
  /// 面值币种（★ Q1 定版 CNY；禁跨币种加减）
  currency String @default("CNY") @db.VarChar(8)
  /// 当前余额（守卫列，禁旁路写：只允许 ledger.post() 同事务原子 UPDATE）
  balance  Decimal @default(0.00) @db.Decimal(14, 2)
  /// 期初余额（回填 = 旧 dg_users.money，之后不再变）
  openingAmount Decimal @default(0.00) @map("opening_amount") @db.Decimal(14, 2)
  /// ACTIVE / FROZEN（对账不平即冻结，docs/02 §5.3）
  status        String  @default("ACTIVE") @db.VarChar(16)
  /// 乐观锁行版本（并发扣款的守卫比对列）
  rowVersion    Int     @default(0) @map("row_version")
  /// 旧 dg_users.last_balance_changed_at
  lastChangedAt DateTime? @map("last_changed_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([kind, memberId])
  @@index([memberId])
  @@map("accounts")
}

/// 账本分录（append-only，不可变；更正只能加反向分录）。
/// 旧源：dg_record（807 万，客户侧）+ finance_order_cash_flow（102 万，采购侧）
/// + dg_record_old（599 万，已停写归档；是否并入 = Q2 业务可见性问题）
model LedgerEntry {
  /// ★ 新分配（非旧 rid）：dg_record 与 dg_record_old 的 rid 各自自增、数值空间重叠，
  ///   对齐旧 id 必撞号 → 对齐关系改由 (legacySource, legacyId) 承载（§4.12）
  id            BigInt  @id @default(autoincrement())
  accountId     BigInt  @map("account_id")
  /// IN / OUT，与 signedAmount 符号互相校验（旧库实测 82 行违规）
  direction     String  @db.VarChar(4)
  /// 带符号金额：IN 正 / OUT 负（旧 money 语义直迁）
  signedAmount  Decimal @map("signed_amount") @db.Decimal(14, 2)
  /// 动账前后余额快照（旧 accountmoney 的升级版；post() 内断言链式连续）
  balanceBefore Decimal @map("balance_before") @db.Decimal(14, 2)
  balanceAfter  Decimal @map("balance_after") @db.Decimal(14, 2)
  /// ★ Q1 定版 CNY（对日市场 ≠ 记账用日元）
  currency      String  @default("CNY") @db.VarChar(8)
  /// 业务原因词表（正本在 contract；取代旧 action + paytype 的费用侧）
  flowType      String  @map("flow_type") @db.VarChar(40)
  /// 渠道（取代旧 paytype 的渠道侧；费用类分录为 NULL）
  channel       String? @db.VarChar(24)
  /// ★ 幂等键 {flowType}:{bizType}:{bizId}:{occurrence}（旧库同名列 100% NULL）
  idempotencyKey String   @map("idempotency_key") @db.VarChar(128)
  orderId        Int?     @map("order_id")
  sendOrderId    Int?     @map("send_order_id")
  rechargeOrderId BigInt?  @map("recharge_order_id")

  // ---- 采购侧（旧 cash_flow 一行四金额 → 拆列；paid_money 是派生值，★ 不落库，§4.8）----
  /// 对方收款额（旧 price）
  counterpartAmount Decimal? @map("counterpart_amount") @db.Decimal(14, 2)
  /// 砍价额（旧 bargain_price）
  bargainAmount     Decimal? @map("bargain_amount") @db.Decimal(14, 2)
  /// 采购运费（旧 send_price）
  freightAmount     Decimal? @map("freight_amount") @db.Decimal(14, 2)

  /// 汇率快照三件套（旧库完全没有，汇率对账的前提）
  rate            Decimal? @db.Decimal(12, 8)
  /// HUILV / MANUAL / GATEWAY
  rateSource      String?  @map("rate_source") @db.VarChar(16)
  rateRefId       BigInt?  @map("rate_ref_id")
  /// 当时用的计费规则快照（可回溯「按什么算」）
  feeRuleSnapshot Json?    @map("fee_rule_snapshot")

  /// 人工/后台动作的操作人（会员自助为 NULL）
  operatorId      Int?   @map("operator_id")
  /// ★ action=0 类分录必须挂审批单（旧库只靠随机 sn 连回去，§3.9/§4.4）
  approvalId      BigInt? @map("approval_id")
  /// 人工调整原因码（取代旧自由文本 remark 承担语义的做法）
  adjustReason    String? @map("adjust_reason") @db.VarChar(32)
  /// 更正分录指向被更正的原分录
  correctsEntryId BigInt? @map("corrects_entry_id")
  /// 账户间划转的成对键（双边配平校验）
  pairKey         String? @map("pair_key") @db.VarChar(64)

  /// 人读文案（旧 remark；★ 禁 HTML、禁承担幂等或汇率语义）
  label        String?  @db.VarChar(255)
  /// 旧 `sn` 一列三义（凭证号 / 物流单号 / 空串）→ 拆两列 + JSON 兜其余（§3.9）
  voucherNo    String?  @map("voucher_no") @db.VarChar(32)
  logisticsNo  String?  @map("logistics_no") @db.VarChar(64)
  logisticsNos Json?    @map("logistics_nos")
  /// 从旧 remark HTML 里剥出来的 URL（§6.4：剥标签只留文本与 URL）
  bizNos       Json?    @map("biz_nos")
  /// 回填来源与旧主键（rid 空间重叠靠这两列定位；镜像行也用它去重）
  legacySource String?  @map("legacy_source") @db.VarChar(32)
  legacyId     BigInt?  @map("legacy_id")
  /// 业务时刻（对账按此列；补录时 ≠ createdAt）
  occurredAt   DateTime @map("occurred_at") @db.DateTime(0)
  /// 账本不可变：无 updatedAt / deletedAt（反向分录即更正）
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([accountId, idempotencyKey])
  @@unique([legacySource, legacyId])
  @@index([accountId, flowType, occurredAt]) // 旧 idx_uid_action_addtime 的真实口径
  @@index([orderId])
  @@index([sendOrderId])
  @@index([rechargeOrderId])
  @@index([pairKey])
  @@map("ledger_entries")
}

/// 入金单据（旧源 dg_rechargerecord，59 万）。★ 只装「渠道入金」，费用类/负向调整搬去 ledger
model RechargeOrder {
  id       BigInt @id @default(autoincrement()) // == 旧 rid（单据表仍照主键对齐铁律）
  memberId Int    @map("member_id")             // == 旧 uid
  /// 原币金额（旧 amount，JPY 面值：dg_rechargerecord.amount 是全库少数真日元列之一）
  sourceAmount   Decimal @map("source_amount") @db.Decimal(14, 2)
  sourceCurrency String  @default("JPY") @map("source_currency") @db.VarChar(8)
  /// 入账金额（旧 money，CNY 面值）
  creditedAmount Decimal @map("credited_amount") @db.Decimal(14, 2)
  /// ★ 换算依据（旧库无列，只能 amount/money 反推，且 PayPal/Stripe 反推值含手续费）
  rate       Decimal @db.Decimal(12, 8)
  rateSource String  @default("HUILV") @map("rate_source") @db.VarChar(16)
  /// 渠道（旧 paytype 拆分后的渠道侧）：BANK_TRANSFER / PAYPAL / STRIPE ...
  channel      String  @db.VarChar(24)
  channelLabel String? @map("channel_label") @db.VarChar(64) // 旧 payname
  /// PENDING(1) / AUDITED(3) / COMPLETED(2) / REJECTED(-1)
  /// ★ 加钱时刻 = 进入 AUDITED（银行）或 COMPLETED（其它），不是「有 successtime」（§3.2）
  status                 String  @default("PENDING") @db.VarChar(16)
  gatewayTransactionNo   String? @map("gateway_transaction_no") @db.VarChar(128)
  submittedByAdminId     Int?    @map("submitted_by_admin_id")
  auditedByAdminId       Int?    @map("audited_by_admin_id")
  proofAttachmentUrl     String? @map("proof_attachment_url") @db.VarChar(200)
  bankName               String? @map("bank_name") @db.VarChar(64)
  payerTel               String? @map("payer_tel") @db.VarChar(20)
  /// hho / gouba / NULL=yiwutaro（旧 source：一库多站的分野）
  sourceSystem String?   @map("source_system") @db.VarChar(32)
  submittedAt  DateTime? @map("submitted_at") @db.DateTime(0) // 旧 addtime
  creditedAt   DateTime? @map("credited_at") @db.DateTime(0)  // 旧 successtime
  /// 加钱分录回填，双向可验（对账第 1 类）
  ledgerEntryId BigInt?  @map("ledger_entry_id")
  notes         Json?
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  /// ★ 渠道幂等（旧库有列但 PHP 侧 0 引用，实测非 NULL 率待 Q6 复核）
  @@unique([gatewayTransactionNo])
  @@index([memberId, status])
  @@index([status, creditedAt])
  @@map("recharge_orders")
}

/// 汇率时间序列（旧源 dg_huilv；★ 旧 float(10,2) 对 0.045 量级只剩 2 位有效数字）
model ExchangeRate {
  id    BigInt @id @default(autoincrement())
  base  String @db.VarChar(8) // JPY
  quote String @db.VarChar(8) // CNY
  rate  Decimal @db.Decimal(12, 8)
  /// MITSUBISHI / YAHOO / DB_CACHE / MANUAL（旧 Currency.php:165-198 的四级降级链）
  source String @db.VarChar(16)
  /// 旧硬编码加点（三菱 +0.5 / Yahoo +0.8）规则化
  spreadApplied Decimal @default(0) @map("spread_applied") @db.Decimal(12, 8)
  effectiveAt   DateTime @map("effective_at") @db.DateTime(0)
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([base, quote, effectiveAt])
  @@map("exchange_rates")
}

/// 对账批次（docs/02 §5.3 五类；旧系统 0 张对账表）
model ReconciliationBatch {
  id    BigInt @id @default(autoincrement())
  /// PAYMENT_CHANNEL / BALANCE / SUPPLIER / LOGISTICS / EXCHANGE_RATE
  type       String   @db.VarChar(24)
  windowFrom DateTime @map("window_from") @db.DateTime(0)
  windowTo   DateTime @map("window_to") @db.DateTime(0)
  /// RUNNING / CLEAN / DIFF_FOUND / FROZEN / RESOLVED
  status      String   @default("RUNNING") @db.VarChar(16)
  expectedTotal Decimal? @map("expected_total") @db.Decimal(14, 2)
  actualTotal   Decimal? @map("actual_total") @db.Decimal(14, 2)
  diffAmount    Decimal? @map("diff_amount") @db.Decimal(14, 2)
  diffCount     Int      @default(0) @map("diff_count")
  handledByAdminId Int?  @map("handled_by_admin_id")
  finishedAt    DateTime? @map("finished_at") @db.DateTime(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  /// 同窗口重跑幂等
  @@unique([type, windowFrom, windowTo])
  @@index([type, status])
  @@map("reconciliation_batches")
}

/// 对账差异明细（左=期望 / 右=实际；处置可追）
model ReconciliationDiff {
  id       BigInt @id @default(autoincrement())
  batchId  BigInt @map("batch_id")
  leftKey  String @map("left_key") @db.VarChar(128)
  rightKey String? @map("right_key") @db.VarChar(128)
  expectedAmount Decimal @map("expected_amount") @db.Decimal(14, 2)
  actualAmount   Decimal @map("actual_amount") @db.Decimal(14, 2)
  diffAmount     Decimal @map("diff_amount") @db.Decimal(14, 2)
  /// MISSING_ENTRY / DUPLICATED_ENTRY / CHAIN_BROKEN / RATE_DRIFT / AMOUNT_EDITED /
  /// STATE_SKIPPED ...（★ CHAIN_BROKEN 的存量基线见 §6.4「链断不静默修复」）
  reasonCode  String @map("reason_code") @db.VarChar(32)
  /// OPEN / ACCEPTED / CORRECTED / WRITTEN_OFF
  disposition      String  @default("OPEN") @db.VarChar(16)
  handledByAdminId Int?    @map("handled_by_admin_id")
  alertEventId     BigInt? @map("alert_event_id")
  detail           Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  /// 重跑不重复登记
  @@unique([batchId, leftKey, reasonCode])
  @@index([disposition, reasonCode])
  @@map("reconciliation_diffs")
}

/// 费率规则（收 order 域 Q7：5% / 1.05 / PayPal / Stripe / 汇率加点；dffee 留会员列）
model FeeRule {
  id    BigInt @id @default(autoincrement())
  code  String @db.VarChar(40)
  value Decimal @db.Decimal(12, 8)
  /// PERCENT / MULTIPLIER / FIXED / SPREAD
  mode     String  @db.VarChar(16)
  currency String? @db.VarChar(8)
  /// 会员档位（NULL = 全员通用）
  memberTier    String?  @map("member_tier") @db.VarChar(24)
  effectiveFrom DateTime @map("effective_from") @db.DateTime(0)
  updatedBy     Int?     @map("updated_by")
  note          String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([code, effectiveFrom])
  @@map("fee_rules")
}

/// 告警事件（钉钉出口；幂等 + 频控，防每轮对账刷屏）
model AlertEvent {
  id     BigInt @id @default(autoincrement())
  /// LEDGER_CHAIN_BROKEN / RECON_DIFF / NEGATIVE_BALANCE / DUPLICATE_CREDIT / BARGAIN_THRESHOLD ...
  code     String @db.VarChar(40)
  /// 去重键：同一差异在多轮对账里只播一次
  dedupKey String @map("dedup_key") @db.VarChar(128)
  /// INFO / WARN / CRITICAL
  severity String  @default("WARN") @db.VarChar(8)
  payload  Json?
  /// PENDING / SENT / SUPPRESSED / RESOLVED
  status     String    @default("PENDING") @db.VarChar(16)
  sentAt     DateTime? @map("sent_at") @db.DateTime(0)
  retryCount Int       @default(0) @map("retry_count")
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([dedupKey])
  @@index([status, createdAt])
  @@map("alert_events")
}

/// 告警通道（替掉 config/services.php 里「一业务一组硬编码」，§4.13）
model AlertChannel {
  id   BigInt @id @default(autoincrement())
  code String @db.VarChar(40)
  /// DINGTALK / GENERIC_WEBHOOK / EMAIL
  kind String @db.VarChar(16)
  /// ★ 禁明文 webhook/secret 入库：只存凭证入口引用（docs/07 §5.5 AES-GCM）
  credentialRef String @map("credential_ref") @db.VarChar(128)
  /// HMAC_SHA256（旧 DingtalkWebhookClient:47-63 的加签）/ NONE
  signType String? @map("sign_type") @db.VarChar(16)
  /// 旧封装只支持 MARKDOWN；TEXT 预留
  msgType  String  @default("MARKDOWN") @map("msg_type") @db.VarChar(16)
  /// 通道级附加参数（at 手机号、代理等）
  config   Json?
  enabled  Boolean @default(true)
  note     String? @db.VarChar(255)
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([code])
  @@map("alert_channels")
}

/// 告警规则（code → 通道 + 阈值 + 静默窗口；一个 code 可指两个出口，§4.13）
model AlertRule {
  id        BigInt @id @default(autoincrement())
  /// 与 alert_events.code 同词表
  code      String @db.VarChar(40)
  channelId BigInt @map("channel_id")
  /// INFO / WARN / CRITICAL
  severity      String  @default("WARN") @db.VarChar(8)
  /// 单值阈值（如砍价占比 0.3）；复杂条件进 thresholdJson
  thresholdValue Decimal? @map("threshold_value") @db.Decimal(14, 2)
  thresholdJson  Json?    @map("threshold_json")
  /// 静默窗口（秒）：同 dedupKey 在窗口内不再播
  silenceWindowSec Int     @default(3600) @map("silence_window_sec")
  /// 替代旧 Console/Kernel 的 cron 表达式（超时订单每 30 分钟那条）
  scheduleCron String?   @map("schedule_cron") @db.VarChar(64)
  /// 分块推送大小（旧 chunk=100）
  chunkSize    Int       @default(100) @map("chunk_size")
  enabled      Boolean   @default(true)
  note         String?   @db.VarChar(255)
  deletedAt    DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  /// 同一 code 指多个出口 = 多条记录（Grid 红字 + 钉钉推送并存）
  @@unique([code, channelId])
  @@index([channelId, enabled])
  @@map("alert_rules")
}

/// 旧→新镜像水位（§6.2：T1 期间 dg_record 由旧系统独占记账，新侧只做投影）
model LegacySyncWatermark {
  id     BigInt @id @default(autoincrement())
  /// 被镜像的旧表名（本域只有 dg_record 需要持续镜像）
  sourceTable  String @map("source_table") @db.VarChar(64)
  /// 与 ledger_entries.legacy_source 同词表（DG_RECORD / DG_RECORD_OLD / CASH_FLOW）
  legacySource String @map("legacy_source") @db.VarChar(32)
  /// 上次成功的旧主键（★ 按 rid 单调推进，比 addtime 可靠：实测同秒多行 + 存在补录）
  lastLegacyId  BigInt    @default(0) @map("last_legacy_id")
  lastWindowEnd DateTime? @map("last_window_end") @db.DateTime(0)
  /// 左叠条数（重跑兜边界，等价于拉单三板斧的「左叠 5 分钟」在 id 轴上的形态）
  overlapCount  Int       @default(200) @map("overlap_count")
  /// 上轮扫到但被 member 过滤的孤儿行数（对账用）
  skippedRows   BigInt    @default(0) @map("skipped_rows")
  lagRows       BigInt    @default(0) @map("lag_rows")
  /// ACTIVE / PAUSED / BLOCKED（BLOCKED = 连续失败超阈值，禁继续镜像以免掩盖问题）
  status        String    @default("ACTIVE") @db.VarChar(16)
  lastRunAt     DateTime? @map("last_run_at") @db.DateTime(0)
  lastSuccessAt DateTime? @map("last_success_at") @db.DateTime(0)
  lastError     String?   @map("last_error") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(0)

  @@unique([sourceTable])
  @@index([status, lastRunAt])
  @@map("legacy_sync_watermarks")
}

/// 一分录 ↔ 多订单（取代 261 万行无唯一键的 relation_order_and_finance_order_cash_flow）
model LedgerEntryOrder {
  id        BigInt @id @default(autoincrement())
  entryId   BigInt @map("entry_id")
  orderId   Int    @map("order_id")
  /// 采购侧金额在本单上的分摊值（旧表把 4 个金额塞一行，此处按需拆到单）
  allocatedAmount Decimal? @map("allocated_amount") @db.Decimal(14, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([entryId, orderId])
  @@index([orderId])
  @@map("ledger_entry_orders")
}

// ============================================================================
// order 域（2026-10-14）
//
// 设计依据：docs/plans/order-schema.md（精读旧系统后）
//   - Q5 已拍板：OrderGroup 显式化，bargainAmount 挂组级，carrier/holder 机制删除
//     （docs/plans/05-order-group-评审与拍板.md）
//   - 金额一律 Decimal(14,2)（2026-10-15 Q8 定版）；★ 对客列与采购成本列**同一币种 CNY**
//     （Q1 定版：旧库 goodsprice/goodsuprice/sendprice/余额/流水面值都是 CNY），
//     分组维度是「对客价 vs 采购成本价」，不是币种
//   - 状态机 12 态 cas 更新 + order_status_histories 历史表（替代旧 10 个时间戳列）
//   - 回填主键对齐：orders.id == dg_order.oid；其余表 id == 旧表主键
//   - ⚠ order_groups.tid 的 collation 须 utf8mb4_general_ci（raw SQL，见 0002a）
// ============================================================================

/// 采购单分组（tid）。旧系统无此表：整单砍价挂在组内某个 oid 上（holder 机制），
/// 本表使其显式化（Q5 拍板，2026-10-14）
model OrderGroup {
  id     Int @id @default(autoincrement())
  /// 平台交易号（1688 一次店铺下单 = 一个 tid）。NULL = 未关联平台的手动建单/空 tid 历史单
  /// ⚠ collation 必须显式 utf8mb4_general_ci（raw SQL MODIFY，见 0002a 脚本）——
  ///   与 unicode_ci 列 JOIN/UNION 会报 Illegal mix of collations
  tid String? @unique @db.VarChar(64)
  /// 空 tid 单独立成组时的源 oid（回填幂等键：tid 为 NULL 时 UNIQUE 不去重，用此列保证
  /// 重复执行不产生重复组；tid 组为 NULL）。新系统写入的组不使用此列
  legacyOrderId Int? @unique @map("legacy_order_id")
  /// 会员（旧 dg_order.uid；禁冗余 uname/memberid）
  memberId Int @map("member_id")
  /// 供应商店铺快照（supplier 域 shop_id；禁外键）
  supplierShopId Int? @map("supplier_shop_id")
  /// 整单砍价总额（旧 dg_order.bargainprice 按 tid SUM 汇总）——组级唯一正本
  bargainAmount Decimal @default(0.00) @map("bargain_amount") @db.Decimal(14, 2)
  /// 砍价返金时间（旧 dg_sendorder.bargainstate 的 order 侧对照；finance 事件后回写）
  bargainRefundedAt DateTime? @map("bargain_refunded_at") @db.DateTime(0)
  /// 组内订单行对客运费汇总（旧 sendprice 按 tid SUM）——send-order 已邮寄返金口径源
  shippingFeeTotal Decimal @default(0.00) @map("shipping_fee_total") @db.Decimal(14, 2)
  /// 组创建时间（旧组内 MIN(addtime)）
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(0)

  orders Order[]

  @@index([memberId, createdAt])
  @@map("order_groups")
}

/// 订单行（oid 语义）。旧源 dg_order：一行 = 一个商品（587 万行热表）
model Order {
  id Int @id @default(autoincrement()) // == 旧 dg_order.oid（回填显式对齐）
  /// 所属采购组（旧 tid 分组）；NULL = 独立单
  groupId Int? @map("group_id")
  /// 会员（旧 uid；禁冗余 uname/memberid，§4.10）
  memberId Int @map("member_id")
  /// 订单类型：1 代购 / 2 转运 / 3 一件代发（contract OrderType）
  type Int @default(1) @db.SmallInt
  /// 12 态状态机（contract OrderStatus）：1 采购中/2 已采购/3 在途/4 已入库/5 配送提交/
  /// 6 无效未返金/7 增值检品中/8 航空禁运/9 售後中/10 无效已返金/11 无效已废弃/12 售后待确认
  /// 无效态集合 [6,10,11] 不参与金额计算；cas 更新（UPDATE ... WHERE id=? AND status=?）
  status Int @default(1) @db.SmallInt
  /// 当前态进入时间（旧 13 个时间列按 state 映射；全量原值见 legacyStateTimes）
  statusEnteredAt DateTime @default(now()) @map("status_entered_at") @db.DateTime(0)
  /// 下单来源：web / mzk / admin / api / import / plugin（旧 add_from 合并：0,1,3→web 2→plugin 8→api）
  source String @default("web") @db.VarChar(16)
  /// 创建模式：one_click / manual / auto（旧 purchase_type 0/1/2）
  creationMode String @default("one_click") @map("creation_mode") @db.VarChar(16)
  /// 来源备注（旧 add_from_memo）
  sourceRef String? @map("source_ref") @db.VarChar(64)
  /// 客人外部管理号（旧 outid，对接方重要）
  outId String? @map("out_id") @db.VarChar(80)
  /// 负责公司：HHO / Gouba（业务隔离维度，非冗余）
  belongCompany String? @map("belong_company") @db.VarChar(32)
  /// 支付批次号（旧 payid；语义待确认 Q1，回填保留）
  payId String? @map("pay_id") @db.VarChar(50)
  /// 拍货分派选中值（旧 xz）
  xzAssignee String? @map("xz_assignee") @db.VarChar(50)

  // ---- 商品快照（旧系统全量冗余在订单行，保留：订单是历史事实）----
  goodsId       String? @map("goods_id") @db.VarChar(20)
  goodsUrl      String? @map("goods_url") @db.VarChar(512)
  goodsName     String  @map("goods_name") @db.VarChar(255)
  goodsImg      String? @map("goods_img") @db.VarChar(255)
  /// 订单图片（旧 orderimg）
  orderImg      String? @map("order_img") @db.VarChar(255)
  skuName       String  @default("") @map("sku_name") @db.VarChar(1024)
  goodsSize     String? @map("goods_size") @db.VarChar(20)
  goodsColor    String? @map("goods_color") @db.VarChar(20)
  goodsSeller   String? @map("goods_seller") @db.VarChar(50)
  goodsSite     String? @map("goods_site") @db.VarChar(50)
  /// supplier 域引用（禁外键）
  supplierShopId    Int? @map("supplier_shop_id")
  supplierProductId Int? @map("supplier_product_id")
  /// 代发商品名（旧 dfgoodsname）
  dfGoodsName String? @map("df_goods_name") @db.VarChar(20)

  // ---- 数量与金额（同币种 CNY；分组维度 = 对客价 / 采购成本价）----
  quantity Int @default(1)
  /// 对客单价 CNY（旧 goodsprice，float→Decimal 无损）
  unitPrice Decimal @default(0.00) @map("unit_price") @db.Decimal(14, 2)
  /// 砍后单价 CNY（旧 goodsprice1；OrderGroup.bargainAmount 分摊后的行级派生展示值）
  bargainedUnitPrice Decimal @default(0.00) @map("bargained_unit_price") @db.Decimal(14, 2)
  /// 促销价 CNY（旧 proprice）
  promoPrice Decimal? @map("promo_price") @db.Decimal(14, 2)
  /// 对客运费 CNY（旧 sendprice）
  shippingFee Decimal @default(0.00) @map("shipping_fee") @db.Decimal(14, 2)
  /// 采购单价 CNY（旧 goodsuprice，成本）
  purchaseUnitPrice Decimal @default(0.00) @map("purchase_unit_price") @db.Decimal(14, 2)
  /// 采购国内运费 CNY（旧 senduprice，成本）
  purchaseShippingFee Decimal @default(0.00) @map("purchase_shipping_fee") @db.Decimal(14, 2)
  /// 验货金额 CNY（旧 inspection）
  inspectionFee Decimal @default(0.00) @map("inspection_fee") @db.Decimal(14, 2)
  /// 下单时实扣金额快照（payOrder 服务端重算结果；正本在 finance.ledger_entries）
  chargedAmount   Decimal @default(0.00) @map("charged_amount") @db.Decimal(14, 2)
  chargedCurrency String  @default("CNY") @map("charged_currency") @db.VarChar(3)
  /// 服务费抵扣（旧 extend.deducted_service_fee 显式化）
  serviceFeeOffset Decimal @default(0.00) @map("service_fee_offset") @db.Decimal(14, 2)

  // ---- 物流/到库（关系只存一侧，§4.5；后缀显式化，§3.8）----
  /// 运单号（旧 sid；只存这一侧，禁 dg_sendorder.oids 双写）
  sendOrderId Int? @map("send_order_id")
  /// 国内物流号（旧 expressno）——存原始号，禁 _S 后缀编码
  domesticTrackingNo String? @map("domestic_tracking_no") @db.VarChar(100)
  /// 补发单号（旧 bufaid）
  reissueNo String? @map("reissue_no") @db.VarChar(255)
  /// 补发序号（旧 _N 后缀显式化；NULL = 非补发）
  reissueSeq Int? @map("reissue_seq")
  /// 是否售后包裹（旧 _S 后缀显式化）
  isAfterSale Boolean @default(false) @map("is_after_sale")
  /// 重量 g（旧 orderweight）
  weightGrams Int? @map("weight_grams")
  /// 运输方式：1 空运 / 2 海运 / 3 敏感货（旧 ship）
  shipMethod Int? @map("ship_method") @db.SmallInt
  /// 敏感货标记（旧 flag：2 是 / 1 不是）
  isSensitive Boolean @default(false) @map("is_sensitive")

  // ---- 代发/库存（WMS 边界：库存台账归 WMS）----
  /// 一件代发库存单（旧 dfstoremode=1）
  dfStoreMode Boolean @default(false) @map("df_store_mode")

  // ---- 条款与标记 ----
  /// { qtyShortBuy, priceAdjust, shippingAdjust }（旧 TermQty/TermPrice/TermShipping 字符串布尔）
  terms Json?
  /// 紧急订单（旧 isjinji varchar 当布尔）
  isUrgent Boolean @default(false) @map("is_urgent")
  /// 收藏标记（旧 mark_flag 位 0-1：0 默认/1 收藏；mark_flag 是 2bit 一态打包整数）
  isFavorite Boolean @default(false) @map("is_favorite")
  /// 到货标记（旧 mark_flag 位 2-3：0 默认/1 已到货/2 处理中/3 失败）
  arrivalMark Int? @default(0) @map("arrival_mark") @db.UnsignedTinyInt

  // ---- 检品/增值选项（旧 var1-var12 + yanhuo 家族 + 平台标签 30+ 列 → JSON 受控词表）----
  /// [{ code, enabled, textValue }]；code 词表正本在 contract（InspectionOptionCode）
  /// 布尔语义：只有 true 算勾选，禁 "1"/"0" 字符串布尔（旧系统已发生误写入事故）
  inspectionOptions Json? @map("inspection_options")
  /// 强类型列（旧 yanhuoasin/yanhuofnsku 显式化）
  asin          String? @db.VarChar(64)
  fnsku         String? @db.VarChar(64)
  fbaShipmentId String? @map("fba_shipment_id") @db.VarChar(64)

  // ---- 备注族（旧 goodsremark/goodsremark1-4/mremark/orderremark 六列）----
  /// 买家备忘（API 层 buyer_memo；dg_order 无此列，回填 NULL）
  buyerRemark String? @map("buyer_remark") @db.VarChar(512)
  /// 管理备注（旧 mremark）
  adminRemark String? @map("admin_remark") @db.VarChar(512)
  /// 历史备注兜底（旧 goodsremark/goodsremark1-4/orderremark 原样 JSON）
  remarksExtra Json? @map("remarks_extra")
  /// 旧 extend 兜底（deducted_service_fee/inquiry 来源等，Q9 契约化后清退）
  extendExtra Json? @map("extend_extra")
  /// 自动下单失败原因（旧 auto_order_error）
  autoOrderError String? @map("auto_order_error") @db.VarChar(512)
  /// 旧 13 个状态时间戳列原值（审计保真；新写入走 order_status_histories）
  legacyStateTimes Json? @map("legacy_state_times")

  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0) // 旧 addtime
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(0)      // 旧 uptime
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)

  group            OrderGroup?           @relation(fields: [groupId], references: [id])
  extension        OrderExtension?
  platformCreation OrderPlatformCreation?
  clientRef        OrderClientRef?
  messages         OrderMessage[]
  examinations     OrderExamination[]
  statusHistories  OrderStatusHistory[]
  valueAddedServices OrderValueAddedService[]
  invalidMarks     OrderInvalidMark[]
  splits           OrderSplit[]          @relation("SplitMain")
  splitChildren    OrderSplit[]          @relation("SplitSource")
  skuOrderLinks    PlatformSkuOrderLink[]

  @@index([memberId, createdAt])
  @@index([status])
  @@index([groupId])
  @@index([outId])
  @@index([source, createdAt])
  @@index([domesticTrackingNo])
  @@index([sendOrderId])
  @@map("orders")
}

/// 订单状态历史（旧系统无此表：10+ 个时间戳列平铺在 dg_order 上）
